# Production Compose only: full image reference from the GitLab Container Registry.
# Use <CI_REGISTRY_IMAGE>:latest or <CI_REGISTRY_IMAGE>:yyyymmdd-shortsha.
INDEXER_IMAGE=""

COOKIE_XF_USER=""
# Alternative to COOKIE_XF_USER: username/email, password and optional Base32 TOTP secret.
# With both modes configured, the cookie is used first and login refreshes it if needed.
F95_USERNAME=""
F95_PASSWORD=""
F95_TOTP_SECRET=""
# Optional upstream HTTP CONNECT or SOCKS5 proxy; URL-encode credentials if required.
# Native mode supports SOCKS5 auth; browser mode requires an HTTP relay for it.
F95_PROXY=""
# Native HTTP User-Agent override. Empty keeps F95Indexer/...; browser mode ignores it.
F95_USER_AGENT=""
# Optional FlareSolverr base URL; empty uses native direct/proxy transport.
# Local Compose profile: http://flaresolverr:8191; external: http://192.168.2.6:8191
F95_FLARESOLVERR_URL=""
# FlareSolverr request timeout in integer seconds.
F95_FLARESOLVERR_TIMEOUT=60

BIND_HOST="127.0.0.1"
BIND_PORT=8069

REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""
